# Supabase dashboard > Project Settings > API. Server-side only: this key
# bypasses row level security, so never put it in the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

JWT_SECRET=
GEMINI_API_KEY=
PORT=3000

# Optional. Defaults to gemini-3.1-flash-lite (fast). gemini-3.5-flash is slower but more thorough.
GEMINI_MODEL=
